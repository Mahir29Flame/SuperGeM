{
  "name": "SuperGeM",
  "author": "Mahir29Flame",
  "version": "0.5.6",
  "description": "Fork of Smarty-Gemini with better UI, Native and newer API support.",
  "main": "./build/electron/main.js",
  "scripts": {
    "dump": "stlite desktop ./",
    "serve": "cross-env NODE_ENV=production electron .",
    "app:dir": "electron-builder --dir",
    "app:dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@stlite/cli": "^0.5.0",
    "@stlite/desktop": "^0.105.0",
    "cross-env": "^7.0.3",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.supergem.app",
    "productName": "SuperGeM",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "build/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "stlite": {
    "desktop": {
      "files": [
        "app.py",
        "assets",
        "requirements.txt"
      ],
      "entrypoint": "app.py",
      "requirementsTxtFiles": [
        "requirements.txt"
      ],
      "embed": true
    }
  }
}
